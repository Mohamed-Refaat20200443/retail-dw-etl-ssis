          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{21473B8E-3283-4B3A-9E79-77C8C7D3F89C}"
              SQLTask:SqlStatementSource="MERGE dw.FactOnlineSales AS Target&#xA;USING (&#xA;    SELECT OnlineSalesKey, DateKey, StoreKey, ProductKey, PromotionKey, CurrencyKey, CustomerKey,&#xA;           SalesOrderNumber, SalesOrderLineNumber, SalesQuantity, SalesAmount, ReturnQuantity,&#xA;           ReturnAmount, DiscountQuantity, DiscountAmount, TotalCost, UnitCost, UnitPrice,&#xA;           GrossProfit, NetSalesAmount, ProfitMarginPercent, AverageUnitProfit, &#xA;           [Audit Info.LoadDate] AS LoadDate, PackageName, ETLUser, BatchID&#xA;    FROM transformation.FactOnlineSales_Transformed&#xA;) AS Source&#xA;ON Target.OnlineSalesKey = Source.OnlineSalesKey&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        Target.DateKey = Source.DateKey,&#xA;        Target.StoreKey = Source.StoreKey,&#xA;        Target.ProductKey = Source.ProductKey,&#xA;        Target.PromotionKey = Source.PromotionKey,&#xA;        Target.CurrencyKey = Source.CurrencyKey,&#xA;        Target.CustomerKey = Source.CustomerKey,&#xA;        Target.SalesOrderNumber = Source.SalesOrderNumber,&#xA;        Target.SalesOrderLineNumber = Source.SalesOrderLineNumber,&#xA;        Target.SalesQuantity = Source.SalesQuantity,&#xA;        Target.SalesAmount = Source.SalesAmount,&#xA;        Target.ReturnQuantity = Source.ReturnQuantity,&#xA;        Target.ReturnAmount = Source.ReturnAmount,&#xA;        Target.DiscountQuantity = Source.DiscountQuantity,&#xA;        Target.DiscountAmount = Source.DiscountAmount,&#xA;        Target.TotalCost = Source.TotalCost,&#xA;        Target.UnitCost = Source.UnitCost,&#xA;        Target.UnitPrice = Source.UnitPrice,&#xA;        Target.GrossProfit = Source.GrossProfit,&#xA;        Target.NetSalesAmount = Source.NetSalesAmount,&#xA;        Target.ProfitMarginPercent = Source.ProfitMarginPercent,&#xA;        Target.AverageUnitProfit = Source.AverageUnitProfit,&#xA;        Target.LoadDate = Source.LoadDate,&#xA;        Target.PackageName = Source.PackageName,&#xA;        Target.ETLUser = Source.ETLUser,&#xA;        Target.BatchID = Source.BatchID&#xA;&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (OnlineSalesKey, DateKey, StoreKey, ProductKey, PromotionKey, CurrencyKey, CustomerKey,&#xA;            SalesOrderNumber, SalesOrderLineNumber, SalesQuantity, SalesAmount, ReturnQuantity,&#xA;            ReturnAmount, DiscountQuantity, DiscountAmount, TotalCost, UnitCost, UnitPrice,&#xA;            GrossProfit, NetSalesAmount, ProfitMarginPercent, AverageUnitProfit,&#xA;            LoadDate, PackageName, ETLUser, BatchID)&#xA;    VALUES (Source.OnlineSalesKey, Source.DateKey, Source.StoreKey, Source.ProductKey, Source.PromotionKey,&#xA;            Source.CurrencyKey, Source.CustomerKey, Source.SalesOrderNumber, Source.SalesOrderLineNumber,&#xA;            Source.SalesQuantity, Source.SalesAmount, Source.ReturnQuantity, Source.ReturnAmount,&#xA;            Source.DiscountQuantity, Source.DiscountAmount, Source.TotalCost, Source.UnitCost,&#xA;            Source.UnitPrice, Source.GrossProfit, Source.NetSalesAmount, Source.ProfitMarginPercent,&#xA;            Source.AverageUnitProfit, Source.LoadDate, Source.PackageName, Source.ETLUser, Source.BatchID);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\incremental_Facts\FactSales"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{4830105E-C558-4486-AA4E-A602B5717629}"
