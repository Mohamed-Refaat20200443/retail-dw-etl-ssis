        <DTS:Executable
          DTS:refId="Package\incremental_Facts\FactExchangeRate"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B7D7472D-F1D5-436C-BD6E-B278160836EF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="FactExchangeRate"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{21473B8E-3283-4B3A-9E79-77C8C7D3F89C}"
              SQLTask:SqlStatementSource="MERGE dw.FactExchangeRate AS Target&#xA;USING (&#xA;    SELECT ExchangeRateKey, CurrencyKey, DateKey, AverageRate, EndOfDayRate,&#xA;           RateVariance, RateVariancePercent, RateTrend, &#xA;           [Audit Info.LoadDate] AS LoadDate, PackageName, ETLUser, BatchID&#xA;    FROM transformation.FactExchangeRate_Transformed&#xA;) AS Source&#xA;ON Target.ExchangeRateKey = Source.ExchangeRateKey&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        Target.CurrencyKey = Source.CurrencyKey,&#xA;        Target.DateKey = Source.DateKey,&#xA;        Target.AverageRate = Source.AverageRate,&#xA;        Target.EndOfDayRate = Source.EndOfDayRate,&#xA;        Target.RateVariance = Source.RateVariance,&#xA;        Target.RateVariancePercent = Source.RateVariancePercent,&#xA;        Target.RateTrend = Source.RateTrend,&#xA;        Target.LoadDate = Source.LoadDate,&#xA;        Target.PackageName = Source.PackageName,&#xA;        Target.ETLUser = Source.ETLUser,&#xA;        Target.BatchID = Source.BatchID&#xA;&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (ExchangeRateKey, CurrencyKey, DateKey, AverageRate, EndOfDayRate,&#xA;            RateVariance, RateVariancePercent, RateTrend, LoadDate, PackageName, ETLUser, BatchID)&#xA;    VALUES (Source.ExchangeRateKey, Source.CurrencyKey, Source.DateKey, Source.AverageRate,&#xA;            Source.EndOfDayRate, Source.RateVariance, Source.RateVariancePercent, Source.RateTrend,&#xA;            Source.LoadDate, Source.PackageName, Source.ETLUser, Source.BatchID);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\incremental_Facts\FactInventory"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{651F26D5-FF5A-4BAD-9FF6-AD5AF5910192}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="FactInventory"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{21473B8E-3283-4B3A-9E79-77C8C7D3F89C}"
              SQLTask:SqlStatementSource="MERGE dw.FactInventory AS Target&#xA;USING (&#xA;    SELECT InventoryKey, DateKey, StoreKey, ProductKey, CurrencyKey, OnHandQuantity, OnOrderQuantity,&#xA;           SafetyStockQuantity, UnitCost, DaysInStock, MinDayInStock, MaxDayInStock, Aging,&#xA;           InventoryValue, OnOrderValue, StockStatus, StockCoverageDays, &#xA;           [Audit Info.LoadDate] AS LoadDate, PackageName, ETLUser, BatchID&#xA;    FROM transformation.FactInventory_Transformed&#xA;) AS Source&#xA;ON Target.InventoryKey = Source.InventoryKey&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        Target.DateKey = Source.DateKey,&#xA;        Target.StoreKey = Source.StoreKey,&#xA;        Target.ProductKey = Source.ProductKey,&#xA;        Target.CurrencyKey = Source.CurrencyKey,&#xA;        Target.OnHandQuantity = Source.OnHandQuantity,&#xA;        Target.OnOrderQuantity = Source.OnOrderQuantity,&#xA;        Target.SafetyStockQuantity = Source.SafetyStockQuantity,&#xA;        Target.UnitCost = Source.UnitCost,&#xA;        Target.DaysInStock = Source.DaysInStock,&#xA;        Target.MinDayInStock = Source.MinDayInStock,&#xA;        Target.MaxDayInStock = Source.MaxDayInStock,&#xA;        Target.Aging = Source.Aging,&#xA;        Target.InventoryValue = Source.InventoryValue,&#xA;        Target.OnOrderValue = Source.OnOrderValue,&#xA;        Target.StockStatus = Source.StockStatus,&#xA;        Target.StockCoverageDays = Source.StockCoverageDays,&#xA;        Target.LoadDate = Source.LoadDate,&#xA;        Target.PackageName = Source.PackageName,&#xA;        Target.ETLUser = Source.ETLUser,&#xA;        Target.BatchID = Source.BatchID&#xA;&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (InventoryKey, DateKey, StoreKey, ProductKey, CurrencyKey, OnHandQuantity, OnOrderQuantity,&#xA;            SafetyStockQuantity, UnitCost, DaysInStock, MinDayInStock, MaxDayInStock, Aging,&#xA;            InventoryValue, OnOrderValue, StockStatus, StockCoverageDays, &#xA;            LoadDate, PackageName, ETLUser, BatchID)&#xA;    VALUES (Source.InventoryKey, Source.DateKey, Source.StoreKey, Source.ProductKey, Source.CurrencyKey,&#xA;            Source.OnHandQuantity, Source.OnOrderQuantity, Source.SafetyStockQuantity, Source.UnitCost,&#xA;            Source.DaysInStock, Source.MinDayInStock, Source.MaxDayInStock, Source.Aging,&#xA;            Source.InventoryValue, Source.OnOrderValue, Source.StockStatus, Source.StockCoverageDays,&#xA;            Source.LoadDate, Source.PackageName, Source.ETLUser, Source.BatchID);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\incremental_Facts\FactOnlineSale"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8D0C52BA-E00B-4367-A207-704B2CAF3AFE}"
