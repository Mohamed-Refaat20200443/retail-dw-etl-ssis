          DTS:LocaleID="-1"
          DTS:ObjectName="FactSales"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{21473B8E-3283-4B3A-9E79-77C8C7D3F89C}"
              SQLTask:SqlStatementSource="MERGE dw.FactSales AS Target&#xA;USING (&#xA;    SELECT SalesKey, DateKey, channelKey AS ChannelKey, StoreKey, ProductKey, PromotionKey, CurrencyKey,&#xA;           UnitCost, UnitPrice, SalesQuantity, ReturnQuantity, ReturnAmount, DiscountQuantity, &#xA;           DiscountAmount, TotalCost, SalesAmount, GrossProfit, NetSalesAmount, &#xA;           ProfitMarginPercent, AverageUnitProfit, [Audit Info.LoadDate] AS LoadDate, PackageName, ETLUser, BatchID&#xA;    FROM transformation.FactSales_Transformed&#xA;) AS Source&#xA;ON Target.SalesKey = Source.SalesKey&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        Target.DateKey = Source.DateKey,&#xA;        Target.ChannelKey = Source.ChannelKey,&#xA;        Target.StoreKey = Source.StoreKey,&#xA;        Target.ProductKey = Source.ProductKey,&#xA;        Target.PromotionKey = Source.PromotionKey,&#xA;        Target.CurrencyKey = Source.CurrencyKey,&#xA;        Target.UnitCost = Source.UnitCost,&#xA;        Target.UnitPrice = Source.UnitPrice,&#xA;        Target.SalesQuantity = Source.SalesQuantity,&#xA;        Target.ReturnQuantity = Source.ReturnQuantity,&#xA;        Target.ReturnAmount = Source.ReturnAmount,&#xA;        Target.DiscountQuantity = Source.DiscountQuantity,&#xA;        Target.DiscountAmount = Source.DiscountAmount,&#xA;        Target.TotalCost = Source.TotalCost,&#xA;        Target.SalesAmount = Source.SalesAmount,&#xA;        Target.GrossProfit = Source.GrossProfit,&#xA;        Target.NetSalesAmount = Source.NetSalesAmount,&#xA;        Target.ProfitMarginPercent = Source.ProfitMarginPercent,&#xA;        Target.AverageUnitProfit = Source.AverageUnitProfit,&#xA;        Target.LoadDate = Source.LoadDate,&#xA;        Target.PackageName = Source.PackageName,&#xA;        Target.ETLUser = Source.ETLUser,&#xA;        Target.BatchID = Source.BatchID&#xA;&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (SalesKey, DateKey, ChannelKey, StoreKey, ProductKey, PromotionKey, CurrencyKey,&#xA;            UnitCost, UnitPrice, SalesQuantity, ReturnQuantity, ReturnAmount, DiscountQuantity,&#xA;            DiscountAmount, TotalCost, SalesAmount, GrossProfit, NetSalesAmount,&#xA;            ProfitMarginPercent, AverageUnitProfit, LoadDate, PackageName, ETLUser, BatchID)&#xA;    VALUES (Source.SalesKey, Source.DateKey, Source.ChannelKey, Source.StoreKey, Source.ProductKey,&#xA;            Source.PromotionKey, Source.CurrencyKey, Source.UnitCost, Source.UnitPrice, &#xA;            Source.SalesQuantity, Source.ReturnQuantity, Source.ReturnAmount, Source.DiscountQuantity,&#xA;            Source.DiscountAmount, Source.TotalCost, Source.SalesAmount, Source.GrossProfit,&#xA;            Source.NetSalesAmount, Source.ProfitMarginPercent, Source.AverageUnitProfit,&#xA;            Source.LoadDate, Source.PackageName, Source.ETLUser, Source.BatchID);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
